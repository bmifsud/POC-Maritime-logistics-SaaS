{
  "name": "adlc-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:components": "playwright test",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:ci": "playwright test --forbid-only",
    "test:maritime": "playwright test --config=playwright.maritime.config.ts",
    "test:maritime:demo": "playwright test --config=playwright.maritime.config.ts --workers=1",
    "test:maritime:type-check": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution Bundler --skipLibCheck pages/BookingPage.ts fixtures/maritimeFixtures.ts tests/maritime/*.ts",
    "demo:controller": "node support/maritime/controller.mjs",
    "bom": "cyclonedx-npm --spec-version 1.7 --output-format JSON --output-file ../.adlc/evidence/aibom.json",
    "demo:preflight": "node support/maritime/preflight.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@playwright/test": "1.61.0",
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.1.18",
    "typescript": "5.7.2",
    "vite": "6.4.5"
  }
}
