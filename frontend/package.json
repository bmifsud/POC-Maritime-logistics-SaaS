{
  "name": "adlc-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "test": "playwright test",
    "test:components": "playwright test",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:ci": "playwright test --forbid-only",
    "bom": "cyclonedx-npm --spec-version 1.7 --output-format JSON --output-file ../.adlc/evidence/aibom.json"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@playwright/test": "1.61.0",
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.1.18",
    "typescript": "5.7.2",
    "vite": "6.4.5"
  }
}
